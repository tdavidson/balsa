{
  "name": "balsa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "esbuild": "0.25.12"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo:generate": "node fixtures/demo-saas/generate.mjs",
    "demo:check": "node fixtures/demo-saas/generate.mjs --check",
    "verify": "pnpm run doctor && pnpm typecheck && pnpm test && pnpm build",
    "build": "pnpm --filter @finance/web build",
    "dev": "pnpm --filter @finance/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "acceptance": "pnpm --filter @balsa/ingestion test && pnpm --filter @balsa/finance-engine test && pnpm --filter @balsa/model-export test && pnpm --filter @finance/database exec tsx ../../scripts/company-zero-smoke.ts",
    "isolation": "pnpm --filter @finance/database exec tsx ../../scripts/multi-company-isolation.ts",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @finance/database db:generate",
    "db:migrate": "pnpm --filter @finance/database db:migrate",
    "db:studio": "pnpm --filter @finance/database db:studio"
  }
}
