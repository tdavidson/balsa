# PostgreSQL (Neon in hosted V0; any standard PostgreSQL works)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance

# Authentication (default: Better Auth)
# Generate a value with: openssl rand -base64 32
AUTH_MODE=better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://nevermodel.example.com
# Public sign-up is disabled in production unless explicitly enabled during
# initial provisioning.
# AUTH_ALLOW_SIGN_UP=true
# One-time bridge from disabled local mode to Better Auth. On the first Better
# Auth sign-in with this exact email, Nevermodel keeps the existing user,
# company, data, and settings and replaces only its login identity. Remove
# after the claim succeeds.
# AUTH_CLAIM_EXISTING_EMAIL=owner@example.com

# For a single-user local install only, set AUTH_MODE=disabled. Do not expose
# disabled mode directly to the internet; use a reverse proxy or VPN instead.
# LOCAL_OWNER_EMAIL=owner@localhost
# LOCAL_OWNER_NAME=User
# LOCAL_OWNER_ID=local-owner
# Production disabled-login mode requires an explicit acknowledgement.
# ALLOW_AUTH_DISABLED=true

# Model provider
MODEL_PROVIDER=openrouter
MODEL_NAME=auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Application
APP_SECRET=
CRON_SECRET=
HEALTHCHECK_SECRET=
# Names only the company created during first-time provisioning. Companies
# added later from the account menu are unaffected.
DEFAULT_COMPANY_NAME=

# Optional hosted object storage (not used until ingestion)
FILE_STORAGE=local
FILE_STORAGE_PATH=.data/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: models offered in the composer, as Label=id pairs. "Auto" (MODEL_NAME) is always first.
# MODEL_OPTIONS=GPT-5=openai/gpt-5,Claude Sonnet 4.5=anthropic/claude-sonnet-4.5
