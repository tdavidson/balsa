# PostgreSQL (any standard PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance

# Authentication (default: Better Auth)
# Generate a value with: openssl rand -base64 32
AUTH_MODE=better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://nevermodel.example.com
# Public sign-up is disabled in production unless explicitly enabled during
# initial provisioning.
# AUTH_ALLOW_SIGN_UP=true
# Registration passcode, strongly recommended whenever sign-up is enabled on a
# reachable host: every registrant must type it, and it is the same mechanism a
# multi-user installation uses to admit each new user. Remove
# AUTH_ALLOW_SIGN_UP once provisioning is finished.
# AUTH_SIGN_UP_CODE=

# For a single-user local install only, set AUTH_MODE=disabled. Do not expose
# disabled mode directly to the internet; use a reverse proxy or VPN instead.
# The installation owner's email. In disabled mode it is the operator identity;
# in Better Auth mode the account registered with this email owns the original
# company and its data.
# LOCAL_OWNER_EMAIL=owner@localhost
# LOCAL_OWNER_NAME=User
# LOCAL_OWNER_ID=local-owner
# Production disabled-login mode requires an explicit acknowledgement.
# ALLOW_AUTH_DISABLED=true

# Model provider
MODEL_PROVIDER=openrouter
MODEL_NAME=auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Application
APP_SECRET=
CRON_SECRET=
HEALTHCHECK_SECRET=
# Names only the company created during first-time provisioning. Companies
# added later from the account menu are unaffected, and the owner's COMPANIES
# list replaces it entirely.
DEFAULT_COMPANY_NAME=
# Companies to keep for the installation owner, as Name or Name:CUR entries
# separated by commas (currency defaults to USD). They are created on the
# owner's first sign-in, the first one becoming the default company; names
# added here later are created on the next sign-in. Nothing is ever renamed or
# removed when an entry is edited or dropped. The account menu's New company
# does the same thing interactively.
# COMPANIES=Acme Holdings:USD,Beta GmbH:EUR

# File storage
FILE_STORAGE=local
FILE_STORAGE_PATH=.data/files

# Optional public site with product documentation. When set, the application
# shows a "How Nevermodel works" link pointing at it.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: models offered in the composer, as Label=id pairs. "Auto" (MODEL_NAME) is always first.
# MODEL_OPTIONS=GPT-5=openai/gpt-5,Claude Sonnet 4.5=anthropic/claude-sonnet-4.5
